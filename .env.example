# Frontend. Empty value gives a static, honest, no-live-data experience.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BASE_PATH=

# Backend service. Use managed PostgreSQL/Supabase and Redis in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokeradar
REDIS_URL=redis://localhost:6379
API_PORT=8787
API_CORS_ORIGINS=http://localhost:3000,https://mwrtyy.github.io

# Web Push. Generate with: pnpm --filter @poke-fr/backend exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# Optional extra discovery URLs. Separate multiple URLs with commas.
FNAC_START_URLS=
KING_JOUET_START_URLS=https://www.king-jouet.com/jeux-jouets/toutes-les-cartes-pokemon-a-collectionner/page1.htm
CARREFOUR_START_URLS=https://www.carrefour.fr/p/pokemon-coffret-ex-juin-start-2-2026-pokemon-0196214139770
LA_GRANDE_RECRE_START_URLS=https://www.lagranderecre.fr/cartes-a-collectionner-pokemon.html

# Conservative defaults. Robots rules and per-domain spacing take precedence.
DISCOVERY_INTERVAL_MS=21600000
PRODUCT_CHECK_INTERVAL_MS=3600000
MAX_DISCOVERED_URLS_PER_CYCLE=100
PORT=8787
